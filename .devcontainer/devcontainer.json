{
    "name": "MMRotate 1.x",
    "dockerFile": "./Dockerfile",
    "runArgs": [
      "--gpus=all",
      "--shm-size=2gb"
    ],
    "mounts": [
      //"source=${localWorkspaceFolder}/data/DOTA,target=${containerWorkspaceFolder}/data/DOTA,type=bind,consistency=cached",
      //"source=${localWorkspaceFolder}/data/DIOR,target=${containerWorkspaceFolder}/data/DIOR,type=bind,consistency=cached",
      "source=${localWorkspaceFolder}/data/HRSC2016,target=${containerWorkspaceFolder}/data/hrsc,type=bind,consistency=cached"
    ],
    "customizations": {
        "vscode": {
          "extensions": [
            "ms-python.python",
            "ms-python.vscode-pylance"
          ]
        }
    },
    "postCreateCommand": "pip install -e ."
}